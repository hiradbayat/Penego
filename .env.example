# MySQL DSN (required)
DATABASE_DSN=root:password@tcp(127.0.0.1:3306)/gonet?charset=utf8mb4&parseTime=True&loc=Local

# Bind address (default localhost for safety)
LISTEN_ADDR=127.0.0.1:8585

# Lab admin password for the web UI
ADMIN_PASSWORD=penego

# Cookie signing secret — change in any shared environment
SESSION_SECRET=change-me-penego-session-secret

# Set to true to skip login (local trusted only)
AUTH_DISABLED=false

# Scan limits
MAX_HOSTS=1024
MAX_PORTS=4096
DEFAULT_HOST_CONCURRENCY=100
DEFAULT_PORT_CONCURRENCY=100

# API rate limit per client IP
RATE_LIMIT_PER_MIN=60
