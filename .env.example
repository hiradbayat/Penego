# MySQL DSN (required)
DATABASE_DSN=root:password@tcp(127.0.0.1:3306)/gonet?charset=utf8mb4&parseTime=True&loc=Local

LISTEN_ADDR=127.0.0.1:8585
ADMIN_PASSWORD=penego
SESSION_SECRET=change-me-penego-session-secret
AUTH_DISABLED=false

# Multi-user (seeds admin from ADMIN_PASSWORD on first boot)
USE_DB_USERS=true

# Reject targets outside engagement scope when engagement_id is set
ENFORCE_SCOPE=true

# Authorized single-credential checks
AUTHCHECK_ENABLED=true
AUTHCHECK_PER_MINUTE=10

MAX_HOSTS=1024
MAX_PORTS=4096
DEFAULT_HOST_CONCURRENCY=100
DEFAULT_PORT_CONCURRENCY=100
RATE_LIMIT_PER_MIN=60
